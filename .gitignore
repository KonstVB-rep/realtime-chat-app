# --- Зависимости (Никогда не коммитим!) ---
node_modules/
.pnp
.pnp.js

# --- Файлы блокировки (Коммитим ТОЛЬКО один, остальные игнорируем) ---
# Если используете npm -> оставляем package-lock.json, удаляем остальные
# Если yarn -> оставляем yarn.lock
# Для чистоты учебного проекта часто игнорируют все, но стандарт - коммитить один лок-файл.
yarn.lock
pnpm-lock.yaml

# --- Сборки и генерируемые файлы ---
# Next.js
.next/
/out/

# TypeScript / Node.js Build
dist/
build/
*.tsbuildinfo

# --- Переменные окружения (Безопасность!) ---
.env
.env.local
.env.*.local

# --- Логи и ОС ---
npm-debug.log*
yarn-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/